# Copie este archivo como .env. Las rutas relativas parten de la raiz del proyecto.
DOCKER_IMAGE=forensic-media-search:dev
OUTPUT_DIRECTORY=./output
CLIP_CACHE_DIRECTORY=./models
HF_CACHE_DIRECTORY=./models/huggingface
TOP_K=5000
BATCH_SIZE=64
SIGLIP_MODEL=google/siglip2-base-patch16-224
SIGLIP2_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
CLIP_MODEL=ViT-B/32
OPENAI_CLIP_REVISION=d05afc436d78f1c48dc0dbf8e5980a9d471f35f6
DEVICE=cuda
RRF_CONSTANT=60
# Dejar vacio para procesar todas las imagenes.
MAX_IMAGES=
REPORT_PREFIX=report
# Defaults del flujo interactivo de evaluación final (opcionales).
EVALUATOR_TOP_K=300
EVALUATOR_RRF_CONSTANT=60
